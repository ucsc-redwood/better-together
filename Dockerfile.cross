# LEGACY cross-compile environment (JetPack-6-era, CUDA 12.6) for the Jetson Orin
# CUDA backend. Since 2026-07-02 the DEFAULT is bt-cross:7.2 (Dockerfile.cross-7.2,
# CUDA 13.2 matching the reflashed fleet); keep this image for JetPack-6 targets or
# users still on L4T r36.
#
#   docker build -t bt-cross:6.1 -f Dockerfile.cross .
#   # then: cmake --preset jetson && cmake --build --preset jetson   (inside the image)
#   # or: BT_CROSS_IMAGE=bt-cross:6.1 scripts/cross-build-jetson.sh
#
# Base = NVIDIA's x86 cross-compile image: native nvcc 12.6 + aarch64-linux-gnu-g++-11
# + a JetPack sysroot, matching JetPack 6.x (Ubuntu 22.04, glibc 2.35, sm_87).
# We only add a current CMake (the base ships 3.22.1, too old for CUDA_STANDARD 20).
#
# !! TOOLCHAIN/FLEET VERSION SKEW (2026-07-01): both Jetsons (duck-stable/duck-naughty)
# were reflashed to JetPack 7.2 (L4T R39.2.0, CUDA 13.2, Ubuntu 24.04). NVIDIA publishes
# NO 7.x tag of this cross image (NGC tags end at 6.1 -- checked 2026-07-01), so this
# CUDA 12.6 image remains the cross-build path. VERIFIED 2026-07-02: its binaries are
# CORRECT on the JetPack 7.2 stack -- all three test-*-cu differential suites pass on
# both ducks (and bm-prof-tree-cu incl. CUB kernels runs cleanly).
#
# Path to a 13.2-matching cross image (2026-07-02): JetPack 7 is SBSA-aligned, and the
# official cross toolchain IS public as apt debs -- `cuda-cross-sbsa-13-2` in
# https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/cross-linux-sbsa/
# (same thing SDK Manager installs as the "CUDA Cross Compile (SBSA)" host component).
# A DIY image = ubuntu:24.04 + cuda-toolkit-13-2 (x86 nvcc) + cuda-cross-sbsa-13-2 +
# g++-aarch64-linux-gnu. Still blocked on porting apps/tree/cuda off the CUB APIs that
# CUDA 13 removed -- port that first, then build the image.
FROM nvcr.io/nvidia/jetpack-linux-aarch64-crosscompile-x86:6.1

ARG CMAKE_VERSION=3.31.6
RUN wget -qO /tmp/cmake.tgz \
      "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz" \
 && tar -xzf /tmp/cmake.tgz -C /opt \
 && rm /tmp/cmake.tgz \
 && ln -sf "/opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/cmake" /usr/local/bin/cmake \
 && ln -sf "/opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/ctest" /usr/local/bin/ctest

# Put nvcc on PATH (so ptxas/cicc resolve) — toolchain file pins the absolute path too.
ENV PATH=/usr/local/cuda-12.6/bin:${PATH}
WORKDIR /workspace
