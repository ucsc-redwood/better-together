#version 460

precision highp float;
precision highp int;

// Fully-connected layer, layout F1(b) of cifar-gpu-kernels: batch split. A workgroup computes
// kLinearBtFeaturesPerGroup output features for the whole batch (up to ROW_W * IPL images), so
// it streams its weight rows once per batch. Per input chunk the workgroup stages its rows'
// weights in shared memory; a 16-lane row owns FPR features, and lane l of the row owns images
// l, l + 16, ... and accumulates whole dot products (no cross-lane reduction), its inputs read
// from global memory and the weights broadcast from shared memory.
//
// Dispatcher contract: in_features % 4 == 0, N <= ROW_W * IPL, grid (ceil(out_features / 32), 1, 1).

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer InputBuffer {
  vec4 input_data4[];  // [N, in_features/4]
};

layout(std430, set = 0, binding = 1) readonly buffer WeightBuffer {
  vec4 weight_data4[];  // [out_features, in_features/4]
};

layout(std430, set = 0, binding = 2) readonly buffer BiasBuffer {
  float bias_data[];  // [out_features]
};

layout(std430, set = 0, binding = 3) writeonly buffer OutputBuffer {
  float output_data[];  // [N, out_features]
};

layout(push_constant) uniform Params {
  int N;
  int in_features;
  int out_features;
  int apply_relu;
}
params;

const int ROW_W = 16;  // lanes per row
const int ROWS = 16;   // rows per workgroup
const int FPR = 2;     // output features per row
const int IPL = 8;     // images per lane: N <= 128
const int KC4 = 16;    // weight vec4s per row staged per chunk

shared vec4 sh_w[ROWS * FPR * KC4];  // 8 KB

void main() {
  const int tid = int(gl_LocalInvocationID.x);
  const int lane = tid % ROW_W;
  const int row = tid / ROW_W;
  const int wg_of = int(gl_WorkGroupID.x) * ROWS * FPR;
  const int of0 = wg_of + row * FPR;
  const int in_f4 = params.in_features / 4;

  float acc0[IPL];
  float acc1[IPL];
  for (int i = 0; i < IPL; ++i) {
    acc0[i] = 0.0;
    acc1[i] = 0.0;
  }

  for (int c4 = 0; c4 < in_f4; c4 += KC4) {
    for (int i = tid; i < ROWS * FPR * KC4; i += 256) {
      const int of = wg_of + i / KC4;
      const int j = c4 + i % KC4;
      sh_w[i] = (of < params.out_features && j < in_f4) ? weight_data4[of * in_f4 + j] : vec4(0.0);
    }
    barrier();
    const int kend = min(KC4, in_f4 - c4);
    for (int k = 0; k < kend; ++k) {
      const vec4 w0 = sh_w[(row * FPR) * KC4 + k];
      const vec4 w1 = sh_w[(row * FPR + 1) * KC4 + k];
      for (int i = 0; i < IPL; ++i) {
        const int n = lane + ROW_W * i;
        if (n < params.N) {
          const vec4 x = input_data4[n * in_f4 + c4 + k];
          acc0[i] += dot(w0, x);
          acc1[i] += dot(w1, x);
        }
      }
    }
    barrier();
  }

  for (int i = 0; i < IPL; ++i) {
    const int n = lane + ROW_W * i;
    if (n >= params.N) break;
    for (int f = 0; f < FPR; ++f) {
      const int of = of0 + f;
      if (of < params.out_features) {
        float v = (f == 0 ? acc0[i] : acc1[i]) + bias_data[of];
        if (params.apply_relu != 0 && v < 0.0) v = 0.0;
        output_data[n * params.out_features + of] = v;
      }
    }
  }
}
