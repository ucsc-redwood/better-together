/**
 * Multi-workgroup (device-wide) LSD radix sort - histogram pass.
 * VkRadixSort written by Mirco Werner: https://github.com/MircoWerner/VkRadixSort
 * Based on Intel's Embree:
 * https://github.com/embree/embree/blob/v4.0.0-ploc/kernels/rthwif/builder/gpu/sort.h
 *
 * Each workgroup builds a 256-bin histogram over its contiguous block of the
 * input and writes it to g_histograms[RADIX_SORT_BINS * #WORKGROUPS]. Paired
 * with multi_radixsort_warp{16,32,64} (the scatter pass). 4x8-bit passes.
 */
#version 460
#extension GL_GOOGLE_include_directive : enable

#define WORKGROUP_SIZE 256
#define RADIX_SORT_BINS 256

layout(local_size_x = WORKGROUP_SIZE) in;

layout(push_constant, std430) uniform PushConstants {
  uint g_num_elements;
  uint g_shift;
  uint g_num_workgroups;
  uint g_num_blocks_per_workgroup;
};

layout(std430, set = 0, binding = 0) buffer elements_in { uint g_elements_in[]; };

layout(std430, set = 0, binding = 1) buffer histograms {
  // [histogram_of_workgroup_0 | histogram_of_workgroup_1 | ... ]
  uint g_histograms[];  // |g_histograms| = RADIX_SORT_BINS * #WORKGROUPS
};

shared uint[RADIX_SORT_BINS] histogram;

void main() {
  // initialize histogram
  if (gl_LocalInvocationID.x < RADIX_SORT_BINS) {
    histogram[gl_LocalInvocationID.x] = 0U;
  }
  barrier();

  for (uint index = 0; index < g_num_blocks_per_workgroup; index++) {
    uint elementId = gl_WorkGroupID.x * g_num_blocks_per_workgroup * WORKGROUP_SIZE +
                     index * WORKGROUP_SIZE + gl_LocalInvocationID.x;
    if (elementId < g_num_elements) {
      const uint bin = uint(g_elements_in[elementId] >> g_shift) & uint(RADIX_SORT_BINS - 1);
      atomicAdd(histogram[bin], 1U);
    }
  }
  barrier();

  if (gl_LocalInvocationID.x < RADIX_SORT_BINS) {
    g_histograms[RADIX_SORT_BINS * gl_WorkGroupID.x + gl_LocalInvocationID.x] =
        histogram[gl_LocalInvocationID.x];
  }
}
