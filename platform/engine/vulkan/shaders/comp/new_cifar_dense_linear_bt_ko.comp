#version 460

precision highp float;
precision highp int;

// Fully-connected layer, layout F1(a) of cifar-gpu-kernels: K outer, batch tiles inner. A
// workgroup computes kLinearBtFeaturesPerGroup output features for the whole batch (up to
// MAX_TILES tiles of TILE images), so it streams its weight rows once per batch. A 16-lane row
// owns FPR features; per input chunk each lane loads its weights once into registers, then for
// every batch tile the tile's inputs are staged in shared memory, the 16 lane partials of each
// image are summed with subgroupClusteredAdd, and lane n of the row adds image n's sums to its
// running outputs, one vec2 (FPR features) per tile in shared memory that only it touches.
//
// Dispatcher contract: in_features % 4 == 0, N <= TILE * MAX_TILES, a subgroup-size-dependent
// pipeline (size pinned, >= 16, full subgroups) on a device with clustered subgroup operations,
// grid (ceil(out_features / 32), 1, 1).

#extension GL_KHR_shader_subgroup_clustered : require

layout(local_size_x = 256) in;

layout(constant_id = 0) const int SUBGROUP_SIZE = 16;  // the device's, set by the engine

layout(std430, set = 0, binding = 0) readonly buffer InputBuffer {
  vec4 input_data4[];  // [N, in_features/4]
};

layout(std430, set = 0, binding = 1) readonly buffer WeightBuffer {
  vec4 weight_data4[];  // [out_features, in_features/4]
};

layout(std430, set = 0, binding = 2) readonly buffer BiasBuffer {
  float bias_data[];  // [out_features]
};

layout(std430, set = 0, binding = 3) writeonly buffer OutputBuffer {
  float output_data[];  // [N, out_features]
};

layout(push_constant) uniform Params {
  int N;
  int in_features;
  int out_features;
  int apply_relu;
}
params;

const int ROW_W = 16;     // lanes per row
const int ROWS = 16;      // rows per workgroup
const int FPR = 2;        // output features per row
const int CHUNK4 = 32;    // input vec4s per chunk: ROW_W lanes x 2
const int TILE = 16;      // images per batch tile (one per lane of a row)
const int MAX_TILES = 8;  // N <= 128

shared vec4 sh_in[TILE * CHUNK4];       // one tile's input chunk, 8 KB
shared vec2 sh_out[MAX_TILES * 256];    // [tile][invocation] running outputs, 16 KB

// s[m] without a dynamic vector index (which some compilers lower to scratch memory).
float pick(const vec4 s, const int m) { return m == 0 ? s.x : m == 1 ? s.y : m == 2 ? s.z : s.w; }

void main() {
  const int tid = int(gl_LocalInvocationID.x);
  const int lane = tid % ROW_W;
  const int row = tid / ROW_W;
  const int of0 = (int(gl_WorkGroupID.x) * ROWS + row) * FPR;
  const int in_f4 = params.in_features / 4;
  const int tiles = (params.N + TILE - 1) / TILE;
  const int w_base0 = (of0 < params.out_features ? of0 : 0) * in_f4;
  const int w_base1 = (of0 + 1 < params.out_features ? of0 + 1 : 0) * in_f4;

  for (int t = 0; t < MAX_TILES; ++t) sh_out[t * 256 + tid] = vec2(0.0);

  for (int c4 = 0; c4 < in_f4; c4 += CHUNK4) {
    const int ka = c4 + lane, kb = c4 + lane + ROW_W;
    const vec4 w0a = ka < in_f4 ? weight_data4[w_base0 + ka] : vec4(0.0);
    const vec4 w0b = kb < in_f4 ? weight_data4[w_base0 + kb] : vec4(0.0);
    const vec4 w1a = ka < in_f4 ? weight_data4[w_base1 + ka] : vec4(0.0);
    const vec4 w1b = kb < in_f4 ? weight_data4[w_base1 + kb] : vec4(0.0);
    for (int t = 0; t < tiles; ++t) {
      for (int i = tid; i < TILE * CHUNK4; i += 256) {
        const int n = t * TILE + i / CHUNK4;
        const int j = c4 + i % CHUNK4;
        sh_in[i] = (n < params.N && j < in_f4) ? input_data4[n * in_f4 + j] : vec4(0.0);
      }
      barrier();
      for (int n0 = 0; n0 < TILE; n0 += 4) {
        vec4 p0, p1;
        for (int m = 0; m < 4; ++m) {
          const vec4 xa = sh_in[(n0 + m) * CHUNK4 + lane];
          const vec4 xb = sh_in[(n0 + m) * CHUNK4 + lane + ROW_W];
          p0[m] = dot(w0a, xa) + dot(w0b, xb);
          p1[m] = dot(w1a, xa) + dot(w1b, xb);
        }
        const vec4 s0 = subgroupClusteredAdd(p0, ROW_W);
        const vec4 s1 = subgroupClusteredAdd(p1, ROW_W);
        if (lane >= n0 && lane < n0 + 4) {
          const int m = lane - n0;
          sh_out[t * 256 + tid] += vec2(pick(s0, m), pick(s1, m));
        }
      }
      barrier();
    }
  }

  for (int t = 0; t < tiles; ++t) {
    const int n = t * TILE + lane;
    if (n >= params.N) break;
    const vec2 o = sh_out[t * 256 + tid];
    for (int f = 0; f < FPR; ++f) {
      const int of = of0 + f;
      if (of < params.out_features && SUBGROUP_SIZE >= ROW_W) {
        float v = o[f] + bias_data[of];
        if (params.apply_relu != 0 && v < 0.0) v = 0.0;
        output_data[n * params.out_features + of] = v;
      }
    }
  }
}
