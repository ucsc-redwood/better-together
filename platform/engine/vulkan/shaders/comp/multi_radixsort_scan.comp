#version 460

/**
 * Multi-workgroup (device-wide) LSD radix sort - offsets pass, between the histogram pass
 * (multi_radixsort_histograms) and the scatter pass (multi_radixsort) of each 8-bit digit.
 *
 * One workgroup, one invocation per bin. It turns the per-workgroup histograms
 * g_histograms[RADIX_SORT_BINS * wg + bin] into each workgroup's global scatter offsets, in
 * place: offset[wg][bin] = (keys in bins < bin) + (keys of bin in workgroups < wg). The
 * scatter then reads only its own RADIX_SORT_BINS offsets, where it used to re-read the
 * whole RADIX_SORT_BINS x #WORKGROUPS table in every workgroup (tree-app-improvements B2).
 *
 * SUBGROUP_SIZE is specialization constant 0, set by the engine to the running device's
 * subgroup size (and pinned with requiredSubgroupSize where supported), so the
 * RADIX_SORT_BINS / SUBGROUP_SIZE subgroup-sum array matches the width the shader runs at.
 */
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

#define RADIX_SORT_BINS 256
layout(constant_id = 0) const uint SUBGROUP_SIZE = 32;  // engine-set: 16 Mali, 32/64 AMD

layout(local_size_x = RADIX_SORT_BINS) in;

layout(push_constant, std430) uniform PushConstants {
  uint g_num_elements;
  uint g_shift;
  uint g_num_workgroups;
  uint g_num_blocks_per_workgroup;
};

layout(std430, set = 0, binding = 0) buffer histograms {
  uint g_histograms[];  // RADIX_SORT_BINS * g_num_workgroups: counts in, offsets out
};

shared uint[RADIX_SORT_BINS / SUBGROUP_SIZE] sums;  // subgroup reductions

void main() {
  const uint bin = gl_LocalInvocationID.x;

  // Exclusive sum over the workgroups, per bin; `count` ends as the bin's total.
  uint count = 0;
  for (uint wg = 0; wg < g_num_workgroups; wg++) {
    const uint t = g_histograms[RADIX_SORT_BINS * wg + bin];
    g_histograms[RADIX_SORT_BINS * wg + bin] = count;
    count += t;
  }

  // Exclusive sum of the bin totals over the bins.
  const uint sum = subgroupAdd(count);
  const uint prefix_sum = subgroupExclusiveAdd(count);
  if (subgroupElect()) {
    if (gl_SubgroupID < (RADIX_SORT_BINS / SUBGROUP_SIZE)) {
      sums[gl_SubgroupID] = sum;
    }
  }
  barrier();
  uint bin_offset = prefix_sum;
  for (uint i = 0; i < gl_SubgroupID; i++) {
    bin_offset += sums[i];
  }

  for (uint wg = 0; wg < g_num_workgroups; wg++) {
    g_histograms[RADIX_SORT_BINS * wg + bin] += bin_offset;
  }
}
