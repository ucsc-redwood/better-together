#version 460
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_EXT_control_flow_attributes : require

precision highp float;
precision highp int;

// 3x3 / stride-1 / pad-1 CSR specialization (port of the CUDA win) -- every
// pruned conv in the model is this shape. The generic shader drags one FMA
// chain through the whole CSR row with a runtime `/ kernel_area` +
// `% kernel_size` per nonzero; here the literal 9/3 lets the compiler strength-reduce
// the decode.
//
// The algorithm is subgroup_size_dependent (spec constant 0, set by the engine).
//
// SUBGROUP_SIZE < 32 (Mali, subgroup 16, no scalar unit, so a subgroup-uniform walk is still per
// lane): main_mali. One invocation computes PX adjacent output pixels of a row; it decodes each
// nonzero of the CSR row and loads its weight once, then feeds the PX contiguous inputs of that
// tap. Taps in the padded border, and the masked tail of a row whose width is not a multiple of
// PX, load and write nothing.
//
// SUBGROUP_SIZE >= 32: two paths, chosen per subgroup:
//  * Fast, when every active lane of the subgroup has the same output channel (always
//    the case when out_height*out_width is a multiple of the subgroup size: 32x32,
//    16x16 and 8x8 maps with subgroups of 16..64). The row bounds are then provably
//    uniform (subgroupBroadcastFirst), so the CSR walk -- col_idx and weight loads, the
//    decode -- is scalar work, and each tap costs ONE per-lane input load, issued on a
//    clamped index with no divergent branch. Four independent accumulators.
//  * Fallback otherwise (a subgroup spanning two output channels): the per-lane walk
//    with two accumulators. Correct for any subgroup size and shape; slower.
//
// Same descriptor layout and push constants as new_cifar_sparse_conv2d.
// Dispatcher contract (falls back to the generic shader otherwise):
//   kernel_size == 3, stride == 1, padding == 1.
//   SUBGROUP_SIZE >= 32: one invocation per output (b, out_c, oh, ow).
//   SUBGROUP_SIZE < 32:  one invocation per (b, out_c, oh, ow/PX rounded up).
//   grid.x = ceil(invocations / 256); conv_k3s1p1_contract.hpp computes it (keep PX in step).

layout(constant_id = 0) const uint SUBGROUP_SIZE = 32;  // engine-set: 16 Mali, 32/64 AMD

const int PX = 4;  // SUBGROUP_SIZE < 32 only: output pixels per invocation along the width

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer InputBuffer {
  float input_data[];  // Input layout: [batch, in_channels, in_height, in_width]
};

layout(std430, set = 0, binding = 1) writeonly buffer OutputBuffer {
  float output_data[];  // Output layout: [batch, out_channels, out_height, out_width]
};

layout(std430, set = 0, binding = 2) readonly buffer WeightValsBuffer {
  float weight_vals[];  // Nonzero weight values.
};

layout(std430, set = 0, binding = 3) readonly buffer WeightRowPtrBuffer {
  int weight_row_ptr[];  // Row pointers: length = out_channels + 1.
};

layout(std430, set = 0, binding = 4) readonly buffer WeightColIdxBuffer {
  int weight_col_idx[];  // Column indices (flat kernel index).
};

layout(std430, set = 0, binding = 5) readonly buffer BiasBuffer { float bias_data[]; };

// Same layout as the generic shader; kernel_size/stride/padding are implied 3/1/1.
layout(push_constant) uniform Params {
  int batch_size;    // Number of batches.
  int in_channels;   // Input channels.
  int in_height;     // Input height.
  int in_width;      // Input width.
  int out_channels;  // Output channels.
  int out_height;    // Output height (== in_height).
  int out_width;     // Output width (== in_width).
  int kernel_size;   // Kernel size (== 3).
  int stride;        // Convolution stride (== 1).
  int padding;       // Padding (== 1).
  int relu;          // Flag for ReLU activation (nonzero true).
  int bias_size;     // Bias vector size (0 if bias is not used).
}
params;

// Fallback path -- one nonzero's contribution: literal-constant decode of the flat kernel
// index, 0.0 for taps that land in the padded border.
float tap_generic(int nz, int in_base, int oh, int ow) {
  const int flat_k = weight_col_idx[nz];
  const int in_c = flat_k / 9;
  const int rem = flat_k - in_c * 9;
  const int ky = rem / 3;
  const int kx = rem - ky * 3;
  const int in_y = oh + ky - 1;
  const int in_x = ow + kx - 1;
  if (in_y < 0 || in_y >= params.in_height || in_x < 0 || in_x >= params.in_width) return 0.0;
  return input_data[in_base + in_c * (params.in_height * params.in_width) +
                    in_y * params.in_width + in_x] *
         weight_vals[nz];
}

// Fast path -- nz is subgroup-uniform, so the CSR decode is scalar work; the one per-lane
// memory op is the input load, on a clamped index (no branch, no wait between taps).
float tap_fast(int nz, int in_base, int oh, int ow) {
  const int flat_k = weight_col_idx[nz];
  const int in_c = flat_k / 9;
  const int rem = flat_k - in_c * 9;
  const int ky = rem / 3;
  const int kx = rem - ky * 3;
  const int in_y = oh + ky - 1;
  const int in_x = ow + kx - 1;
  const bool ok = in_y >= 0 && in_y < params.in_height && in_x >= 0 && in_x < params.in_width;
  const int off = in_c * (params.in_height * params.in_width) + in_y * params.in_width + in_x;
  const float v = input_data[ok ? in_base + off : in_base];
  return ok ? v * weight_vals[nz] : 0.0;
}

// One output (b, out_c, oh, ow): the CSR walk of row out_c, with the fast or the fallback path.
float row_sum(const int out_c, const int in_base, const int oh, const int ow) {
  float sum;
  if (subgroupAllEqual(out_c)) {
    // Every active lane walks the same CSR row: make its bounds provably uniform.
    const int row_start = subgroupBroadcastFirst(weight_row_ptr[out_c]);
    const int row_end = subgroupBroadcastFirst(weight_row_ptr[out_c + 1]);
    float s0 = 0.0, s1 = 0.0, s2 = 0.0, s3 = 0.0;
    int nz = row_start;
    for (; nz + 3 < row_end; nz += 4) {
      s0 += tap_fast(nz, in_base, oh, ow);
      s1 += tap_fast(nz + 1, in_base, oh, ow);
      s2 += tap_fast(nz + 2, in_base, oh, ow);
      s3 += tap_fast(nz + 3, in_base, oh, ow);
    }
    for (; nz < row_end; ++nz) s0 += tap_fast(nz, in_base, oh, ow);
    sum = (s0 + s1) + (s2 + s3);
  } else {
    const int row_start = weight_row_ptr[out_c];
    const int row_end = weight_row_ptr[out_c + 1];
    // Two interleaved accumulators break the serial FMA chain over the CSR row.
    float s0 = 0.0;
    float s1 = 0.0;
    int nz = row_start;
    for (; nz + 1 < row_end; nz += 2) {
      s0 += tap_generic(nz, in_base, oh, ow);
      s1 += tap_generic(nz + 1, in_base, oh, ow);
    }
    if (nz < row_end) s0 += tap_generic(nz, in_base, oh, ow);
    sum = s0 + s1;
  }
  return sum;
}

// SUBGROUP_SIZE < 32: PX adjacent outputs (ow0 .. ow0+PX-1 of row oh) of one output channel.
void main_mali() {
  const int H = params.out_height;
  const int W = params.out_width;
  const int w_tiles = (W + PX - 1) / PX;
  const int total = params.batch_size * params.out_channels * H * w_tiles;
  int idx = int(gl_GlobalInvocationID.x);
  if (idx >= total) return;

  const int tx = idx % w_tiles;
  idx /= w_tiles;
  const int oh = idx % H;
  idx /= H;
  const int out_c = idx % params.out_channels;
  const int b = idx / params.out_channels;
  const int ow0 = tx * PX;

  const int in_hw = params.in_height * params.in_width;
  const int in_base = b * params.in_channels * in_hw;

  float acc[PX];
  [[unroll]] for (int j = 0; j < PX; ++j) acc[j] = 0.0;

  const int row_end = weight_row_ptr[out_c + 1];
  for (int nz = weight_row_ptr[out_c]; nz < row_end; ++nz) {
    const int flat_k = weight_col_idx[nz];
    const int in_c = flat_k / 9;
    const int rem = flat_k - in_c * 9;
    const int ky = rem / 3;
    const int kx = rem - ky * 3;
    const int in_y = oh + ky - 1;
    if (in_y < 0 || in_y >= params.in_height) continue;  // the whole tap row is padding
    const float wv = weight_vals[nz];
    const int x0 = ow0 + kx - 1;  // input column of output ow0
    const int p = in_base + in_c * in_hw + in_y * params.in_width + x0;
    [[unroll]] for (int j = 0; j < PX; ++j) {
      if (x0 + j >= 0 && x0 + j < params.in_width) acc[j] += input_data[p + j] * wv;
    }
  }

  float bias = 0.0;
  if (params.bias_size > 0 && out_c < params.bias_size) bias = bias_data[out_c];
  const int out_base = ((b * params.out_channels + out_c) * H + oh) * W + ow0;
  [[unroll]] for (int j = 0; j < PX; ++j) {
    if (ow0 + j < W) {  // masked tail
      float v = acc[j] + bias;
      if (params.relu != 0 && v < 0.0) v = 0.0;
      output_data[out_base + j] = v;
    }
  }
}

void main() {
  if (SUBGROUP_SIZE < 32) {
    main_mali();
    return;
  }

  const int total =
      params.batch_size * params.out_channels * params.out_height * params.out_width;
  int idx = int(gl_GlobalInvocationID.x);
  if (idx >= total) return;

  const int ow = idx % params.out_width;
  idx /= params.out_width;
  const int oh = idx % params.out_height;
  idx /= params.out_height;
  const int out_c = idx % params.out_channels;
  const int b = idx / params.out_channels;

  const int in_base = b * params.in_channels * params.in_height * params.in_width;

  float sum = row_sum(out_c, in_base, oh, ow);
  if (params.bias_size > 0 && out_c < params.bias_size) sum += bias_data[out_c];
  if (params.relu != 0 && sum < 0.0) sum = 0.0;

  const int out_index =
      ((b * params.out_channels + out_c) * params.out_height + oh) * params.out_width + ow;
  output_data[out_index] = sum;
}
