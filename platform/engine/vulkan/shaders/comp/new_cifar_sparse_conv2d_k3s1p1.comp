#version 460
#extension GL_EXT_control_flow_attributes : require

precision highp float;
precision highp int;

// 3x3 / stride-1 / pad-1 CSR conv, the Mali path (mali-conv-kernels): cifar-sparse runs it on GPUs
// with a subgroup below 32 (Mali, subgroup 16, no scalar unit, so a subgroup-uniform walk is still
// per lane), and new_cifar_sparse_conv2d_k3s1p1_oc.comp on 32 and above (cifar-gpu-kernels).
//
// One invocation computes PX adjacent output pixels of a row; it decodes each nonzero of the CSR
// row and loads its weight once, then feeds the PX contiguous inputs of that tap. Taps in the
// padded border, and the masked tail of a row whose width is not a multiple of PX, load and write
// nothing. Measured on the Pixel 7a (mali-conv-kernels): stages 3/5/6/7 -54..-56 % and stage 1
// -16 % with PX 4 (PX 2 and PX 8 gain less). A CSR row staged in shared memory per output channel
// was 49-65 % slower on the 8x8 maps, so it is not used.
//
// Same descriptor layout and push constants as new_cifar_sparse_conv2d.
// Dispatcher contract (falls back to the generic shader otherwise):
//   kernel_size == 3, stride == 1, padding == 1.
//   One invocation per (b, out_c, oh, ow/PX rounded up).
//   grid.x = ceil(invocations / 256); conv_k3s1p1_contract.hpp computes it (keep PX in step).

const int PX = 4;  // output pixels per invocation along the width

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer InputBuffer {
  float input_data[];  // Input layout: [batch, in_channels, in_height, in_width]
};

layout(std430, set = 0, binding = 1) writeonly buffer OutputBuffer {
  float output_data[];  // Output layout: [batch, out_channels, out_height, out_width]
};

layout(std430, set = 0, binding = 2) readonly buffer WeightValsBuffer {
  float weight_vals[];  // Nonzero weight values.
};

layout(std430, set = 0, binding = 3) readonly buffer WeightRowPtrBuffer {
  int weight_row_ptr[];  // Row pointers: length = out_channels + 1.
};

layout(std430, set = 0, binding = 4) readonly buffer WeightColIdxBuffer {
  int weight_col_idx[];  // Column indices (flat kernel index).
};

layout(std430, set = 0, binding = 5) readonly buffer BiasBuffer { float bias_data[]; };

// Same layout as the generic shader; kernel_size/stride/padding are implied 3/1/1.
layout(push_constant) uniform Params {
  int batch_size;    // Number of batches.
  int in_channels;   // Input channels.
  int in_height;     // Input height.
  int in_width;      // Input width.
  int out_channels;  // Output channels.
  int out_height;    // Output height (== in_height).
  int out_width;     // Output width (== in_width).
  int kernel_size;   // Kernel size (== 3).
  int stride;        // Convolution stride (== 1).
  int padding;       // Padding (== 1).
  int relu;          // Flag for ReLU activation (nonzero true).
  int bias_size;     // Bias vector size (0 if bias is not used).
}
params;

// PX adjacent outputs (ow0 .. ow0+PX-1 of row oh) of one output channel.
void main() {
  const int H = params.out_height;
  const int W = params.out_width;
  const int w_tiles = (W + PX - 1) / PX;
  const int total = params.batch_size * params.out_channels * H * w_tiles;
  int idx = int(gl_GlobalInvocationID.x);
  if (idx >= total) return;

  const int tx = idx % w_tiles;
  idx /= w_tiles;
  const int oh = idx % H;
  idx /= H;
  const int out_c = idx % params.out_channels;
  const int b = idx / params.out_channels;
  const int ow0 = tx * PX;

  const int in_hw = params.in_height * params.in_width;
  const int in_base = b * params.in_channels * in_hw;

  float acc[PX];
  [[unroll]] for (int j = 0; j < PX; ++j) acc[j] = 0.0;

  const int row_end = weight_row_ptr[out_c + 1];
  for (int nz = weight_row_ptr[out_c]; nz < row_end; ++nz) {
    const int flat_k = weight_col_idx[nz];
    const int in_c = flat_k / 9;
    const int rem = flat_k - in_c * 9;
    const int ky = rem / 3;
    const int kx = rem - ky * 3;
    const int in_y = oh + ky - 1;
    if (in_y < 0 || in_y >= params.in_height) continue;  // the whole tap row is padding
    const float wv = weight_vals[nz];
    const int x0 = ow0 + kx - 1;  // input column of output ow0
    const int p = in_base + in_c * in_hw + in_y * params.in_width + x0;
    [[unroll]] for (int j = 0; j < PX; ++j) {
      if (x0 + j >= 0 && x0 + j < params.in_width) acc[j] += input_data[p + j] * wv;
    }
  }

  float bias = 0.0;
  if (params.bias_size > 0 && out_c < params.bias_size) bias = bias_data[out_c];
  const int out_base = ((b * params.out_channels + out_c) * H + oh) * W + ow0;
  [[unroll]] for (int j = 0; j < PX; ++j) {
    if (ow0 + j < W) {  // masked tail
      float v = acc[j] + bias;
      if (params.relu != 0 && v < 0.0) v = 0.0;
      output_data[out_base + j] = v;
    }
  }
}
