#version 460
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_EXT_control_flow_attributes : require

precision highp float;
precision highp int;

// 3x3 / stride-1 / pad-1 conv2d specialization (port of the CUDA k3s1p1 win) --
// every conv in AlexNetCIFAR is this shape. The generic conv2d shader is
// latency-bound: one accumulator dragging a serial FMA chain through C*9
// iterations with per-tap bounds checks. Here each thread register-blocks
// OC_TILE=4 output channels: the 9 input taps are loaded ONCE per input channel
// and reused across 4 weight rows.
//
// Two compile-time paths, chosen by the subgroup size (spec constant 0, set by the
// engine; the algorithm is subgroup_size_dependent):
//  * SUBGROUP_SIZE >= 32 (AMD-style GPUs: Radeon 780M, Xclipse; they have a scalar unit):
//    every tap is loaded unconditionally on a clamped index (no divergent branch, no wait
//    between taps), and when every active lane of the subgroup has the same output-channel
//    block the weight base is made provably uniform (subgroupBroadcastFirst), so the weights
//    load as scalar work. Any other subgroup takes the same loop with a per-lane base.
//    Measured -52 % (780M) and -45 % (Xclipse 940) of the five convs.
//  * SUBGROUP_SIZE < 32 (Mali, subgroup 16, no scalar unit, so every lane loads its own copy of
//    the weights): one invocation computes PX adjacent output pixels of a row for OC_TILE
//    channels. Per input channel it loads the 3 x (PX+2) input window and the OC_TILE x 9
//    weights once and reuses each weight PX times. Loads are mask-guarded (the clamped-load
//    form above is 12 % slower on the Pixel 7a); a row whose width is not a multiple of PX
//    ends in a masked tail that loads nothing outside the map and writes nothing.
//
// Dispatcher contract (falls back to the generic shader otherwise):
//   R == S == 3, stride == 1, padding == 1, K % OC_TILE == 0.
//   SUBGROUP_SIZE >= 32: one invocation per (n, k/OC_TILE, p, q).
//   SUBGROUP_SIZE < 32:  one invocation per (n, k/OC_TILE, p, q/PX rounded up).
//   grid.x = ceil(invocations / 256); conv_k3s1p1_contract.hpp computes it (keep PX in step).

layout(constant_id = 0) const uint SUBGROUP_SIZE = 32;  // engine-set: 16 Mali, 32/64 AMD

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer InputBuffer {
  float input_data[];  // [N, C, H, W]
};

layout(std430, set = 0, binding = 1) readonly buffer WeightBuffer {
  float weight_data[];  // [K, C, 3, 3]
};

layout(std430, set = 0, binding = 2) readonly buffer BiasBuffer {
  float bias_data[];  // [K]
};

layout(std430, set = 0, binding = 3) writeonly buffer OutputBuffer {
  float output_data[];  // [N, K, H, W]  (P == H, Q == W for 3x3/s1/p1)
};

// Same layout as the generic conv2d shader; R/S/stride/padding are implied 3/3/1/1.
layout(push_constant) uniform Params {
  int N;           // Batch size
  int C;           // Number of input channels
  int H;           // Input height
  int W;           // Input width
  int K;           // Number of output channels (% OC_TILE == 0)
  int R;           // Kernel height (== 3)
  int S;           // Kernel width  (== 3)
  int stride;      // Convolution stride (== 1)
  int padding;     // Convolution padding (== 1)
  int apply_relu;  // 1 to apply ReLU, 0 otherwise
}
params;

const int OC_TILE = 4;
const int PX = 4;  // SUBGROUP_SIZE < 32 only: output pixels per invocation along W

// Load at an already-clamped (always valid) index; zero when the tap is out of range.
float tap(const int clamped_index, const bool in_range) {
  const float v = input_data[clamped_index];
  return in_range ? v : 0.0;
}

// All C input channels of the 3x3 window at (oh, ow) against OC_TILE weight rows starting at
// weight offset w0 (weight rows oc .. oc+OC_TILE-1 are w0 + i*wrow).
void accumulate(const int w0, const int p_base, const int hw, const bool t, const bool b,
                const bool l, const bool r, out float acc[OC_TILE]) {
  const int C = params.C;
  const int wrow = C * 9;  // one weight row = [C, 3, 3]
  for (int i = 0; i < OC_TILE; ++i) acc[i] = 0.0;

  for (int ic = 0; ic < C; ++ic) {
    const int p0 = p_base + ic * hw;  // row oh-1, col ow-1
    const int p1 = p0 + params.W;  // row oh
    const int p2 = p1 + params.W;  // row oh+1
    const int c1 = p1 + 1;             // centre tap: always in range

    // 9 taps, every load unconditional: an out-of-range tap loads the centre (always valid)
    // through a clamped index and is then zeroed, so there is no divergent branch and no
    // wait between taps.
    const float x0 = tap((t && l) ? p0 : c1, t && l);
    const float x1 = tap(t ? p0 + 1 : c1, t);
    const float x2 = tap((t && r) ? p0 + 2 : c1, t && r);
    const float x3 = tap(l ? p1 : c1, l);
    const float x4 = input_data[c1];
    const float x5 = tap(r ? p1 + 2 : c1, r);
    const float x6 = tap((b && l) ? p2 : c1, b && l);
    const float x7 = tap(b ? p2 + 1 : c1, b);
    const float x8 = tap((b && r) ? p2 + 2 : c1, b && r);

    const int wa = w0 + ic * 9;
    for (int i = 0; i < OC_TILE; ++i) {
      const int w = wa + i * wrow;
      acc[i] += x0 * weight_data[w] + x1 * weight_data[w + 1] + x2 * weight_data[w + 2] +
                x3 * weight_data[w + 3] + x4 * weight_data[w + 4] + x5 * weight_data[w + 5] +
                x6 * weight_data[w + 6] + x7 * weight_data[w + 7] + x8 * weight_data[w + 8];
    }
  }
}

// SUBGROUP_SIZE < 32: PX adjacent output pixels (ow0 .. ow0+PX-1 of row oh) x OC_TILE channels.
void main_mali() {
  const int H = params.H;
  const int W = params.W;
  const int C = params.C;
  const int hw = H * W;

  const int oc_tiles = params.K / OC_TILE;
  const int w_tiles = (W + PX - 1) / PX;
  const int total = params.N * oc_tiles * H * w_tiles;
  int idx = int(gl_GlobalInvocationID.x);
  if (idx >= total) return;

  const int tx = idx % w_tiles;
  idx /= w_tiles;
  const int oh = idx % H;
  idx /= H;
  const int oct = idx % oc_tiles;
  const int n = idx / oc_tiles;
  const int oc = oct * OC_TILE;
  const int ow0 = tx * PX;

  // Row masks, and which of the PX+2 window columns ow0-1 .. ow0+PX lie inside the map.
  const bool t = oh > 0, b = oh < H - 1;
  bool col[PX + 2];
  [[unroll]] for (int i = 0; i < PX + 2; ++i) col[i] = ow0 - 1 + i >= 0 && ow0 - 1 + i < W;

  float acc[OC_TILE][PX];
  [[unroll]] for (int o = 0; o < OC_TILE; ++o) {
    [[unroll]] for (int j = 0; j < PX; ++j) acc[o][j] = 0.0;
  }

  const int wrow = C * 9;  // one weight row = [C, 3, 3]
  // Top-left of the window in channel 0 of image n.
  const int p_base = n * C * hw + (oh - 1) * W + (ow0 - 1);
  for (int ic = 0; ic < C; ++ic) {
    const int p0 = p_base + ic * hw;
    float r0[PX + 2], r1[PX + 2], r2[PX + 2];  // window rows oh-1, oh, oh+1
    [[unroll]] for (int i = 0; i < PX + 2; ++i) {
      r0[i] = 0.0;
      r1[i] = 0.0;
      r2[i] = 0.0;
      if (col[i]) {
        if (t) r0[i] = input_data[p0 + i];
        r1[i] = input_data[p0 + W + i];
        if (b) r2[i] = input_data[p0 + 2 * W + i];
      }
    }

    const int wa = oc * wrow + ic * 9;
    [[unroll]] for (int o = 0; o < OC_TILE; ++o) {
      const int w = wa + o * wrow;
      const float w0 = weight_data[w], w1 = weight_data[w + 1], w2 = weight_data[w + 2];
      const float w3 = weight_data[w + 3], w4 = weight_data[w + 4], w5 = weight_data[w + 5];
      const float w6 = weight_data[w + 6], w7 = weight_data[w + 7], w8 = weight_data[w + 8];
      [[unroll]] for (int j = 0; j < PX; ++j) {
        acc[o][j] += r0[j] * w0 + r0[j + 1] * w1 + r0[j + 2] * w2 + r1[j] * w3 +
                     r1[j + 1] * w4 + r1[j + 2] * w5 + r2[j] * w6 + r2[j + 1] * w7 +
                     r2[j + 2] * w8;
      }
    }
  }

  const int out_base = ((n * params.K + oc) * H + oh) * W + ow0;
  [[unroll]] for (int o = 0; o < OC_TILE; ++o) {
    const float bias = bias_data[oc + o];
    [[unroll]] for (int j = 0; j < PX; ++j) {
      if (ow0 + j < W) {  // masked tail
        float v = bias + acc[o][j];
        if (params.apply_relu != 0) v = max(v, 0.0);
        output_data[out_base + o * hw + j] = v;
      }
    }
  }
}

void main() {
  if (SUBGROUP_SIZE < 32) {
    main_mali();
    return;
  }

  const int H = params.H;
  const int W = params.W;
  const int C = params.C;

  const int oc_tiles = params.K / OC_TILE;
  const int total = params.N * oc_tiles * H * W;
  int idx = int(gl_GlobalInvocationID.x);
  if (idx >= total) return;

  const int ow = idx % W;
  idx /= W;
  const int oh = idx % H;
  idx /= H;
  const int oct = idx % oc_tiles;
  const int n = idx / oc_tiles;
  const int oc = oct * OC_TILE;

  // Edge masks (outH==H, outW==W for s1p1).
  const bool t = oh > 0, b = oh < H - 1, l = ow > 0, r = ow < W - 1;

  const int hw = H * W;
  const int wrow = C * 9;
  // Top-left tap of the 3x3 window in channel 0 of image n.
  const int p_base = n * C * hw + (oh - 1) * W + (ow - 1);

  float acc[OC_TILE];
  if (subgroupAllEqual(oc)) {
    accumulate(subgroupBroadcastFirst(oc) * wrow, p_base, hw, t, b, l, r, acc);
  } else {
    accumulate(oc * wrow, p_base, hw, t, b, l, r, acc);
  }

  const int out_base = ((n * params.K + oc) * H + oh) * W + ow;
  for (int i = 0; i < OC_TILE; ++i) {
    float v = bias_data[oc + i] + acc[i];
    if (params.apply_relu != 0) v = max(v, 0.0);
    output_data[out_base + i * hw] = v;
  }
}
