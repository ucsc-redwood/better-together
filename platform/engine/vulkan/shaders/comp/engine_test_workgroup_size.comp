/**
 * kiss-vk engine self-test (test-kiss-vk), not an app kernel: the workgroup size is three
 * specialization constants, so Algorithm::work_group_size() sets it. Every invocation counts
 * itself into g_out[0]; invocation 0 records gl_WorkGroupSize into g_out[1..3].
 */
#version 460

layout(local_size_x_id = 100, local_size_y_id = 101, local_size_z_id = 102) in;

layout(std430, set = 0, binding = 0) buffer Out { uint g_out[]; };

void main() {
  atomicAdd(g_out[0], 1u);
  if (gl_LocalInvocationIndex == 0) {
    g_out[1] = gl_WorkGroupSize.x;
    g_out[2] = gl_WorkGroupSize.y;
    g_out[3] = gl_WorkGroupSize.z;
  }
}
